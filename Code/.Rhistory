if (val > 0.25 & val < 0.81){
return(TRUE)
}
else{
return(FALSE)
}
}
# Final boundary
isinA5<-function(x){
val1<-(x[1]+1)^2+(x[2]^2)
val2<-(x[1]-1)^2+(x[2]^2)
if (val1 < 0.25){
return(TRUE)
}
if (val2 < 0.25){
return(TRUE)
}
else{
return(FALSE)
}
}
